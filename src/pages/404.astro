---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DOMAIN } from '../data/site';
---

<BaseLayout
  title="Page not found | Public IPTV"
  description="The page you requested does not exist. Return to the Public IPTV home page."
  canonical={`${DOMAIN}/404/`}
  noindexPage={true}
>
  <section class="section" aria-labelledby="nf-h">
    <div class="wrap" style="max-width: 640px; text-align: center;">
      <p><span class="pill pill--violet">Error 404</span></p>
      <h1 id="nf-h" class="mt-4">This page is off air</h1>
      <p class="mt-4" style="font-size: 20px; color: var(--color-slate);">
        The page you requested does not exist or was moved.
      </p>
      <p class="mt-6">
        <a class="btn btn-dark" href="/">Back to home</a>
      </p>
    </div>
  </section>
</BaseLayout>

